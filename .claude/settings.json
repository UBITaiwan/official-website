{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status --porcelain)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "PowerShell(git status)",
      "PowerShell(git status --porcelain)",
      "PowerShell(npm.cmd run dev)",
      "PowerShell(npm.cmd run build)",
      "PowerShell(npm.cmd run check)"
    ]
  }
}
