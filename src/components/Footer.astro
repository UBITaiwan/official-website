      <dl class="site-footer__reg">
        <div><dt>立案字號</dt><dd>台內團字第 1070077614 號</dd></div>
        <div><dt>統一編號</dt><dd>74342501</dd></div>
        <div><dt>主管機關</dt><dd>內政部</dd></div>
      </dl>
      <p class="site-footer__copyright">
        Copyright © 2026 UBI Taiwan – All Rights Reserved.
      </p>
