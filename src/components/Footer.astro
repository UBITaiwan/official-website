  </div>
</footer>

<style>
  .site-footer__logo { width: 220px; max-width: 100%; height: auto; }

  .site-footer {
    background: var(--surface-inverse);
    color: var(--color-brand-100);
    padding-block: var(--space-16) var(--space-8);
    margin-top: var(--space-24);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.4fr 1fr;
    gap: var(--space-8);
  }
  .site-footer__title {
    font-size: var(--text-base);
    color: var(--color-white);
    margin-bottom: var(--space-3);
  }
  .site-footer__desc {
    color: var(--color-brand-200);
    font-size: var(--text-sm);
    margin-bottom: var(--space-3);
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .site-footer a { color: var(--color-brand-200); text-decoration: none; }
  .site-footer a:hover { color: var(--color-white); text-decoration: underline; }
  .site-footer__social { margin-top: var(--space-4); }
  .site-footer__legal {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-brand-800);
  }
  .site-footer__orgname {
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    margin-bottom: var(--space-3);
  }
  .site-footer__reg {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-brand-300);
  }
  .site-footer__reg div { display: flex; gap: var(--space-2); }
  .site-footer__reg dt { color: var(--color-brand-200); }
  .site-footer__reg dt::after { content: '：'; }
  .site-footer__reg dd { margin: 0; font-variant-numeric: tabular-nums; }
  .site-footer__copyright {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-brand-300);
  }
  @media (max-width: 860px) {
    .site-footer__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .site-footer__grid { grid-template-columns: 1fr; }
  }
</style>
