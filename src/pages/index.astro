  .wall__photo:hover img { transform: rotate(0) scale(1.015); }

  .wall__photo--card   { grid-column: 1 / span 5;  }
  .wall__notes         { grid-column: 6 / span 7;  }
  .wall__photo--board  { grid-column: 1 / span 4;  }
  .wall__photo--signs  { grid-column: 5 / span 4;  }
  .wall__photo--house  { grid-column: 9 / span 4;  }

  .wall__photo--card img   { transform: rotate(-1.4deg); }
  .wall__photo--board img  { transform: rotate(1.6deg); }
  .wall__photo--signs img  { transform: rotate(-0.8deg); }
  .wall__photo--house img  { transform: rotate(1deg); }

  /* 手寫答案：不用假的手寫字體，字就是字，手寫感留給照片本身 */
  .wall__notes { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
