  .ask__d { margin: 0; color: var(--color-ink-700); line-height: var(--leading-loose); }

  /* ── 四種力量（原四張等寬卡片）── */
  .forces {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
