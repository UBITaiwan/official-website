    .ask:nth-child(even) { direction: ltr; }
    .forces { grid-template-columns: repeat(2, 1fr); gap: var(--space-8) var(--space-6); }
    .forces::before { display: none; }
    .force:nth-child(even) { margin-top: 0; }
  }
  @media (max-width: 520px) {
    .forces { grid-template-columns: 1fr; }
  }

  .vision__q {
    color: var(--color-brand-800);
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
  }
