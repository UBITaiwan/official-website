  @media (max-width: 900px) {
    .wall__grid { grid-template-columns: repeat(6, 1fr); }
    .wall__photo--card  { grid-column: 1 / span 6; }
    .wall__notes        { grid-column: 1 / span 6; }
    .wall__photo--board { grid-column: 1 / span 3; }
    .wall__photo--signs { grid-column: 4 / span 3; }
