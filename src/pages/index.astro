    align-items: center;
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-ink-300);
  }
  .ask:last-child { border-bottom: 1px solid var(--color-ink-300); }
  /* 左右交錯：第二則把圖放到右邊 */
  .ask:nth-child(even) { direction: rtl; }
  .ask:nth-child(even) > * { direction: ltr; }

  .ask__figure { margin: 0; }
  .ask__figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center 30%; /* 窄螢幕裁切時保留人物臉部 */
    border-radius: var(--radius-md);
  }
  .ask__q {
    position: relative;
    font-size: var(--text-xl);
    line-height: var(--leading-normal);
    color: var(--color-brand-800);
    margin-bottom: var(--space-4);
    text-wrap: balance;
  }
  .ask__q::before {
    content: counter(ask, decimal-leading-zero);
    display: block;
    font-size: var(--text-sm);
    font-weight: 900;
    letter-spacing: .1em;
