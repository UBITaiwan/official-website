<script>
  // ＃生活，本該如此 ____ 的輪替。
  // 使用者要求減少動態時完全不跑，改由 CSS 顯示完整詞彙清單。
  const fill = document.querySelector<HTMLElement>('.fill');
  const words = Array.from(document.querySelectorAll<HTMLElement>('.fill__word'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (fill && words.length > 1 && !reduce.matches) {
    let i = 0;
    let timer = 0;

    const step = () => {
      const prev = words[i];
      i = (i + 1) % words.length;
      prev.classList.remove('is-on');
      prev.classList.add('is-out');
      words[i].classList.remove('is-out');
      words[i].classList.add('is-on');
      window.setTimeout(() => prev.classList.remove('is-out'), 460);
    };

    const play = () => { timer ||= window.setInterval(step, 2600); };
    const pause = () => { window.clearInterval(timer); timer = 0; };

    play();

    // 滑鼠停留時暫停，讓人看得完；離開再繼續
    fill.addEventListener('mouseenter', pause);
    fill.addEventListener('mouseleave', play);
    // 分頁切到背景時不空轉
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
  }
</script>
