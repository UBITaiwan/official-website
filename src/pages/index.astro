  /* ── 三個自問（原三張等寬卡片）── */
  .asks { list-style: none; margin: var(--space-8) 0 0; padding: 0; counter-reset: ask; }
  .ask {
    counter-increment: ask;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
