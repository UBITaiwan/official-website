---
import BaseLayout from '../../layouts/BaseLayout.astro';

// 媒體專區：全站媒體報導的唯一完整清單（single source of truth）。
// 維護規則：新報導只更新此頁；其他頁面僅保留精選背書連結並導流至此。
// 連結一律使用原始網址（不用追蹤短網址）。摘要為原創撰寫，供搜尋引擎索引。

const years = [
  {
    year: '2026',
    items: [
      {
        date: '2026.01',
        media: 'BIEN',
        type: '新聞',
        title: '台灣首本 UBI 主題小說於台北國際發表會登場，BIEN 主席 Sarath Davala 親臨致詞',
        href: 'https://basicincome.org/news/2026/01/%E5%8F%B0%E7%81%A3%E9%A6%96%E6%9C%AC-ubi-%E4%B8%BB%E9%A1%8C%E5%B0%8F%E8%AA%AA%E6%96%BC%E5%8F%B0%E5%8C%97%E5%9C%8B%E9%9A%9B%E7%99%BC%E8%A1%A8%E6%9C%83%E7%99%BB%E5%A0%B4%EF%BC%8Cbien-%E4%B8%BB%E5%B8%AD/',
        summary: '《島嶼新日常》台北國際書展發表會的國際報導，BIEN 全球主席親臨致詞，見證亞洲首部 UBI 主題小說問世。',
      },
    ],
  },
  {
    year: '2025',
    items: [
      {
        date: '2025.10',
        media: '動區動趨',
        type: '新聞',
        title: '全民基本收入（UBI）與區塊鏈，是 AI 浪潮下的社會安全網？',
        href: 'https://www.blocktempo.com/universal-basic-income-ubi-and-blockchain-a-social-safety-net-in-the-age-of-ai/',
        summary: '從區塊鏈與 AI 的視角探討 UBI 作為社會安全網的可能性，觸及科技社群受眾。',
      },
      {
        date: '2025.09',
        media: 'TVBS',
        type: '影音',
        title: '「每月定期發錢給全民」解決台灣 3 危機！專家揭「理想金額」需 9 千億',
        href: 'https://www.youtube.com/watch?v=wvPL0V9VqmM',
        summary: '電視新聞專題報導 UBI Taiwan 的青年基本收入政策提案，解析財源規劃與台灣三大結構性危機。',
      },
      {
        date: '2025.08',
        media: '遠見',
        type: '新聞',
        title: '為何台灣需發「基本收入」？UBI Taiwan：AI 衝擊九成大眾警報已響',
        href: 'https://www.gvm.com.tw/article/123346',
        summary: '遠見專訪 UBI Taiwan，談 AI 對台灣勞動市場的衝擊與基本收入作為制度解方的論述。',
      },
      {
        date: '2025.08',
        media: '遠見',
        type: '新聞',
        title: '每月發一萬，台灣首場「基本收入」實驗如何改變單親家庭生活？',
        href: 'https://www.gvm.com.tw/article/123339',
        summary: '深度報導台灣首場基本收入實驗：單親媽媽在兩年實驗中重建生活節奏的真實歷程。',
      },
      {
        date: '2025.08',
        media: 'BIEN',
        type: '新聞',
        title: '基本收入不是夢想：台灣啟動首場 UBI 制度實驗，打開政策想像的第一槍',
        href: 'https://basicincome.org/news/2025/08/%e5%9f%ba%e6%9c%ac%e6%94%b6%e5%85%a5%e4%b8%8d%e6%98%af%e5%a4%a2%e6%83%b3%ef%bc%9a%e5%8f%b0%e7%81%a3%e5%95%9f%e5%8b%95%e9%a6%96%e5%a0%b4ubi%e5%88%b6%e5%ba%a6%e5%af%a6%e9%a9%97%ef%bc%8c%e6%89%93/',
        summary: '基本收入全球網絡（BIEN）報導台灣實驗與紀錄片首映，讓台灣經驗進入國際倡議社群視野。',
      },
      {
        date: '2025',
        media: 'PeoPo 公民新聞',
        type: '新聞',
        title: '台灣首場「無條件基本收入」實驗，給人發錢可行嗎？',
        href: 'https://www.peopo.org/news/816985',
        summary: '公民新聞視角記錄基本收入實驗的執行與社會討論。',
      },
      {
        date: '2025.03',
        media: '寶博朋友說',
        type: '影音',
        title: '未來不用工作？UBI 給你「自動收入」是趨勢還是空想？AI 時代的人類生存保障！',
        href: 'https://www.youtube.com/watch?v=yayNSPF_McE',
        summary: '與第 11 屆不分區立委葛如鈞（寶博士）對談 AI 時代的生存保障，觸及科技與政策雙重受眾。',
      },
      {
        date: '2025',
        media: '遠見',
        type: '新聞',
        title: '別急著罵！若每個月都普發一萬如何',
        href: 'https://www.gvm.com.tw/article/126048',
        summary: '以普發現金的公共討論為切入點，重新檢視基本收入的政策邏輯。',
      },
    ],
  },
  {
    year: '2024',
    items: [
      {
        date: '2024.12',
        media: '志祺七七',
        type: '影音',
        title: '人人有錢拿！無條件普發基本收入，會鼓勵不勞而獲、造成通膨嗎？實驗結果怎麼說？',
        href: 'https://www.youtube.com/watch?v=jLfbUGYkqZ4',
        summary: '以 UBI Taiwan 的實驗數據回應「不勞而獲」與「通膨」兩大質疑，影片累積超過 10 萬次觀看。',
      },
      {
        date: '2024',
        media: '街頭有派對',
        type: '影音',
        title: '無條件基本收入是大灑幣？還是讓年輕人追求理想？',
        href: 'https://www.youtube.com/watch?v=c6uZGTYBcYI',
        summary: '街訪形式呈現大眾對基本收入的第一反應與討論。',
      },
      {
        date: '2024',
        media: '民視',
        type: '影音',
        title: '哲學談，淺淺地：無條件基本收入 UBI',
        href: 'https://www.youtube.com/watch?v=Mq6XDt_gPnE',
        summary: '從哲學視角討論基本收入的價值基礎。',
      },
    ],
  },
  {
    year: '2023',
    items: [
      {
        date: '2023.09',
        media: '工商時報',
        type: '新聞',
        title: '台灣青年走向世界，8 青年代表參加全球基本收入年會',
        href: 'https://www.ctee.com.tw/news/20230907701023-431401',
        summary: 'UBI Taiwan 首次以正式代表團身份參與韓國首爾 BIEN 全球高峰會的報導。',
      },
      {
        date: '2023',
        media: '科技新報',
        type: '新聞',
        title: '基本收入國際高峰會在台舉辦，推廣基本收入議題',
        href: 'https://today.line.me/tw/v3/article/WW8g2g',
        summary: '報導 UBI Taiwan 主辦的亞太基本收入國際高峰會。',
      },
    ],
  },
  {
    year: '2020–2022',
    items: [
      {
        date: '2020.12',
        media: '中央社',
        type: '影音',
        title: '基本收入遊行 台灣首次登場',
        href: 'https://www.youtube.com/watch?v=oMCA3uruT2w',
        summary: '疫情挑戰下，台灣第一場基本收入「共好時代遊行」的新聞紀錄，號召立委、NGO 與上千位民眾參與。',
      },
      {
        date: '2020',
        media: '換日線',
        type: '文章',
        title: '「人人有錢拿」的無條件基本收入，究竟道理何在？——淺談 UBI 的常見爭議與實驗結果',
        href: 'https://crossing.cw.com.tw/article/14327',
        summary: '整理 UBI 常見爭議與國際實驗結果的科普文章。',
      },
      {
        date: '2020',
        media: '科技新報',
        type: '新聞',
        title: '為每個人該有的機會而戰，美國博士生創立基本收入台灣協會──專訪 Tyler Prochazka',
        href: 'https://today.line.me/tw/v3/article/NPNjkO',
        summary: '創辦人羅泰的專訪，記錄 UBI Taiwan 的創立故事。',
      },
    ],
  },
];

const columns = [
  {
    title: '遠見華人精英論壇專欄',
    href: 'https://www.gvm.com.tw/blog/6827',
    desc: 'UBI Taiwan 於遠見的長期專欄，持續發表基本收入相關的政策評論與觀點。',
  },
  {
    title: 'BIEN 投稿文章',
    href: 'https://basicincome.org/topic/ubi-taiwan/',
    desc: '刊登於基本收入全球網絡（BIEN）官網的英文報導與投稿，向國際社群記錄台灣的行動。',
  },
  {
    title: '天下獨立評論投書',
    href: 'https://opinion.cw.com.tw/blog/profile/52/article/13781',
    desc: '「如果每個月可以多領 15,000 元，你會怎麼花？」——以實驗結果回應大眾疑問。',
  },
  {
    title: '關鍵評論網投書',
    href: 'https://www.thenewslens.com/article/183758',
    desc: '「普發現金會導致亂花錢嗎？」——用數據說明現金發放的實際使用行為。',
  },
];
---

<BaseLayout
  title="媒體專區｜UBI Taiwan"
  description="UBI Taiwan 媒體報導總覽：遠見、TVBS、志祺七七、寶博朋友說等報導與節目，以及專欄投稿、實驗紀錄片與媒體聯絡資訊。"
  current="about-press"
>
  <section class="section section--subtle">
    <div class="container">
      <p class="eyebrow">Press</p>
      <h1>媒體專區</h1>
      <p class="container--narrow" style="margin-inline: 0;">
        UBI Taiwan 的行動持續獲得新聞媒體、影音節目與國際組織的報導。
        本頁彙整完整的媒體露出紀錄，並提供媒體工作者所需的聯絡窗口與素材。
      </p>
      <nav aria-label="頁內目錄">
        <ul class="toc" role="list">
          <li><a class="toc__link" href="#coverage">媒體報導</a></li>
          <li><a class="toc__link" href="#columns">專欄與投稿</a></li>
          <li><a class="toc__link" href="#film">實驗紀錄片</a></li>
          <li><a class="toc__link" href="#kit">媒體聯絡與素材</a></li>
        </ul>
      </nav>
    </div>
  </section>

  <section id="coverage" class="section" aria-labelledby="coverage-title">
    <div class="container">
      <h2 id="coverage-title">媒體報導</h2>
      {years.map((g) => (
        <div class="press-year">
          <h3 class="press-year__label">{g.year}</h3>
          <ul class="press-list" role="list">
            {g.items.map((it) => (
              <li class="press-item">
                <div class="press-item__meta">
                  <span class="press-item__date">{it.date}</span>
                  <span class="press-item__media">{it.media}</span>
                  <span class="press-item__type">{it.type}</span>
                </div>
                <h4 class="press-item__title">
                  <a href={it.href} rel="noopener">{it.title}</a>
                </h4>
                <p class="press-item__summary">{it.summary}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="footnote-note">
        2020 年遊行另有兩篇平面報導、寶博朋友說另有兩集新節目，原始連結整理中，將於下次更新補上。
      </p>
    </div>
  </section>

  <section id="columns" class="section section--muted" aria-labelledby="columns-title">
    <div class="container">
      <h2 id="columns-title">專欄與投稿</h2>
      <p class="container--narrow" style="margin-inline: 0;">
        除了接受報導，我們也主動寫作——在媒體平台上持續發表政策評論與實驗觀察。
      </p>
      <!-- 原本是兩欄卡片；投稿本來就是一份清單，用細線分隔即可 -->
      <ul class="cols">
        {columns.map((c) => (
          <li class="col">
            <h3><a href={c.href} rel="noopener">{c.title}</a></h3>
            <p>{c.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="film" class="section" aria-labelledby="film-title">
    <div class="container container--narrow">
      <h2 id="film-title">實驗紀錄片</h2>
      <p>
        台灣首場基本收入實驗（2023–2025）的兩年歷程被拍攝成紀錄片，於 2025 年 8 月在新北市府中 15
        舉行首映，140 位支持者、NGO 夥伴、政治人物與企業代表到場。
      </p>
      <div class="video-frame">
        <iframe
          src="https://www.youtube-nocookie.com/embed/RLU_vB81oQI"
          title="JUJI × UBI Taiwan《生活改寫計畫》前導短片"
          loading="lazy"
          allowfullscreen
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
        ></iframe>
      </div>
      <ul style="margin-top: var(--space-4);">
        <li><a href="https://drive.google.com/file/d/1f53_SoG7F2s0tFhLCFgYCJzkJ77C-S-Z/view" rel="noopener">紀錄片精華版（5 分鐘）</a></li>
        <li><a href="/experiment/pilot/">實驗計畫完整介紹</a></li>
      </ul>
    </div>
  </section>

  <section id="kit" class="section section--subtle" aria-labelledby="kit-title">
    <div class="container">
      <h2 id="kit-title">媒體聯絡與素材</h2>
      <div class="kit">
        <div class="kit__block">
          <h3>採訪與合作聯絡</h3>
          <p>
            歡迎媒體朋友來信，我們將盡快回覆採訪、節目邀約與資料需求：<br />
            <a href="mailto:contact@ubitaiwan.org?subject=媒體採訪聯絡">contact@ubitaiwan.org</a>
          </p>
          <h4>組織簡介（可直接引用）</h4>
          <p style="margin: 0;">
            UBI Taiwan（台灣無條件基本收入協會）成立於 2017 年，是 BIEN（基本收入全球網絡）的台灣代表組織，
            致力於以實驗、研究與倡議推動無條件基本收入。2023–2025 年完成台灣第一個基本收入實驗，
            並將於 2027 年主辦 BIEN 印太高峰會。
          </p>
        </div>
        <div class="kit__block">
          <h3>常用素材</h3>
          <ul class="kit-list" role="list">
            <li><a href="/images/ubi-logo-002-1-1-1024x559.webp" download>UBI Taiwan logo（彩色版）</a></li>
            <li><a href="/images/UBI-LOGO-03-1-1-1024x559.webp" download>UBI Taiwan logo（白色版）</a></li>
          </ul>
          <h4>速覽數據</h4>
          <ul class="kit-facts" role="list">
            <li>成立於 <strong>2017</strong> 年，BIEN 台灣代表組織</li>
            <li>台灣第 <strong>1</strong> 個基本收入實驗（2023–2025）</li>
            <li>社群追蹤者超過 <strong>2.5 萬</strong>人</li>
            <li>主辦 <strong>4</strong> 屆亞太基本收入國際高峰會</li>
          </ul>
          <p class="footnote-note" style="margin-top: var(--space-3);">
            高解析 logo 原始檔與活動照片，請來信索取。
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .toc {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .toc__link {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--color-white);
    border: 1px solid var(--color-brand-300);
    border-radius: var(--radius-full);
    text-decoration: none;
    font-weight: var(--font-medium);
  }
  .toc__link:hover { background: var(--color-brand-100); }

  .press-year { margin-top: var(--space-8); }
  .press-year__label {
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--color-brand-200);
    border-bottom: 2px solid var(--color-brand-100);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .press-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .press-item {
    background: var(--color-white);
    border: 1px solid var(--color-ink-100);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-6);
    box-shadow: var(--shadow-sm);
  }
  .press-item__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }
  .press-item__date { color: var(--color-ink-500); font-variant-numeric: tabular-nums; }
  .press-item__media { font-weight: var(--font-bold); color: var(--color-brand-700); }
  .press-item__type {
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    color: var(--color-brand-700);
    background: var(--color-brand-100);
    border-radius: var(--radius-full);
    padding: 0 var(--space-3);
    line-height: 1.8;
  }
  .press-item__title { font-size: var(--text-lg); margin-bottom: var(--space-1); line-height: var(--leading-normal); }
  .press-item__title a { color: var(--color-ink-900); text-decoration: none; }
  .press-item__title a:hover { color: var(--color-brand-700); text-decoration: underline; }
  .press-item__summary { margin: 0; color: var(--color-ink-500); font-size: var(--text-sm); }

  .footnote-note {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-ink-500);
  }

  .video-frame {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    margin-top: var(--space-6);
  }
  .video-frame iframe { width: 100%; height: 100%; border: 0; display: block; }

  .kit-list, .kit-facts { list-style: none; margin: 0 0 var(--space-4); padding: 0; display: grid; gap: var(--space-2); }
  .kit-facts strong { color: var(--color-brand-600); }
  /* ── 專欄投稿（原兩欄卡片）── */
  .cols { list-style: none; margin: var(--space-8) 0 0; padding: 0; }
  .col {
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-ink-300);
  }
  .col:last-child { border-bottom: 1px solid var(--color-ink-300); }
  .col h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .col p { margin: 0; color: var(--color-ink-700); line-height: var(--leading-loose); }

  /* ── 媒體聯絡與素材（原兩欄卡片）── */
  .kit {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-12);
    margin-top: var(--space-6);
  }
  .kit__block { border-top: 3px solid var(--color-brand-600); padding-top: var(--space-5); }
  .kit__block h4 { margin-top: var(--space-4); font-size: var(--text-base); }
  @media (max-width: 760px) { .kit { grid-template-columns: 1fr; gap: var(--space-8); } }
</style>
