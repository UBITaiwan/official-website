---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

// 實驗總覽：把兩個階段接回同一條敘事線。
// 改版前「實驗計畫」與「生活自由計畫」在導覽上並排成兩個看似不相干的項目，
// 只有 pilot 頁底部一句話把它們接起來——這頁就是為了修掉那個斷點。

const phases = [
  {
    n: '01',
    status: 'done',
    statusLabel: '已完成',
    span: '2023/09 – 2025/08',
    title: '單親家庭基本收入實驗',
    sub: '台灣第一場基本收入實驗',
    lede: '為一個單親家庭連續兩年提供無條件現金，並以深度訪談與影像完整記錄生活的變化。成果剪輯成紀錄片，於 2025 年 8 月首映。',
    facts: [
      { k: '受試者', v: '1 個單親家庭' },
      { k: '第一年', v: '每月 10,000 元' },
      { k: '第二年', v: '每月 5,000 元' },
      { k: '記錄方式', v: '訪談 · 家訪 · 影像' },
    ],
    href: '/experiment/pilot/',
    cta: '看第一階段的完整成果',
    photo: '/images/紀錄片截圖-4.webp',
    alt: '紀錄片畫面：于媽媽在自家客廳裡笑著',
    caption: '兩年的生活變化，被完整記錄下來',
  },
  {
    n: '02',
    status: 'open',
    // 「報名中」標籤已依協會回饋移除（報名 2026/08/31 截止在即）；
    // 時間軸圓點仍以暖色標示進行中的階段
    statusLabel: null,
    span: '2026/11 – 2027/10',
    title: '生活自由計畫',
    sub: '台灣首例由企業贊助的基本收入實驗',
    lede: 'UBI Taiwan 與 JUJI 招財麻吉合作，擴大受試族群並建立更完整的質化與量化研究架構，同步進行文字訪談、影像拍攝與數據分析。',
    facts: [
      { k: '參與主角', v: '3 位' },
      { k: '每月金額', v: '10,000 元' },
      { k: '完整期間', v: '12 個月' },
      { k: '實驗期間', v: '2026/11 – 2027/10' },
    ],
    href: '/life-freedom/',
    cta: '認識生活自由計畫',
    photo: '/images/25-08-02_12-03-31-1024x683.webp',
    alt: '紀錄片首映會滿場觀眾在戲院內合影，眾人以雙手比出 UBI Taiwan 的手勢',
    caption: '2025 首映會的滿場觀眾，是第二階段的起點',
  },
];
---

<BaseLayout
  title="台灣的實驗｜UBI Taiwan"
  description="UBI Taiwan 在台灣進行的基本收入實驗：第一階段單親家庭實驗（2023–2025）已完成並產出紀錄片，第二階段生活自由計畫（2026–2027）與 JUJI 合作，是台灣第一場由企業贊助的基本收入實驗。"
  current="experiment-overview"
>
  <PageHero
    image="/images/25-08-02_11-39-43-1024x683.webp"
    alt="2025 年紀錄片首映會的座談現場，四位與談人並排而坐，其中一位正拿著麥克風發言"
    eyebrow="台灣的實驗"
    title="不只是主張，我們真的做了"
    lead="基本收入在台灣一直停在「值不值得討論」的階段。UBI Taiwan 決定先做做看——用真實的錢、真實的家庭、真實的兩年，把問題從「會怎樣」變成「已經怎樣」。"
    width={1024} heightAttr={683}
  />

  <section class="section" aria-labelledby="phases-title">
    <div class="container">
      <h2 id="phases-title" class="visually-hidden">兩個階段</h2>

      <ol class="line">
        {phases.map((p) => (
          <li class={`ph ph--${p.status}`}>
            <div class="ph__rail" aria-hidden="true">
              <span class="ph__dot"></span>
            </div>

            <div class="ph__body">
              <div class="ph__meta">
                <span class="ph__n">{p.n}</span>
                {p.statusLabel && <span class={`ph__status ph__status--${p.status}`}>{p.statusLabel}</span>}
                <span class="ph__span">{p.span}</span>
              </div>

              <h3 class="ph__title">{p.title}</h3>
              <p class="ph__sub">{p.sub}</p>
              <p class="ph__lede">{p.lede}</p>

              <dl class="facts">
                {p.facts.map((f) => (
                  <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
                ))}
              </dl>

              <figure class="ph__figure">
                <img src={p.photo} alt={p.alt} width="1024" height="683" loading="lazy" />
                <figcaption>{p.caption}</figcaption>
              </figure>

              <p class="ph__cta">
                <a class={p.status === 'open' ? 'btn btn--warm' : 'btn btn--outline'} href={p.href}>
                  {p.cta}
                </a>
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--subtle" aria-labelledby="why-title">
    <div class="container">
      <div class="why">
        <div>
          <h2 id="why-title">為什麼要自己做實驗？</h2>
          <p>
            全球累積超過百場基本收入實驗，結果一致指出穩定的收入能改善身心壓力、教育投入、
            照顧品質、就業選擇與家庭穩定性。但那些都不是台灣的資料。
          </p>
          <p>
            台灣的社會福利多採審查式制度：需要大量證明、程序繁複，稍微多賺一點就可能失去補助。
            許多隱性貧窮家庭因不符資格而被排除，長期在不確定中掙扎。
            要回答「基本收入適不適合台灣」，只能在台灣做。
          </p>
        </div>
        <ul class="why__links">
          <li><a href="/ubi/world/">看看世界各地怎麼做 →</a></li>
          <li><a href="/ubi/faq/">關於基本收入的 14 個疑問 →</a></li>
          <li><a href="/impact/">UBI Taiwan 的行動里程碑 →</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head { padding-block: var(--space-24) var(--space-12); background: var(--surface-subtle); }
  .head h1 { font-size: clamp(1.9rem, 5vw, var(--text-4xl)); text-wrap: balance; }
  .head__lead {
    max-width: var(--container-narrow); font-size: var(--text-lg);
    line-height: var(--leading-loose); color: var(--color-ink-700); margin: 0;
  }

  /* ── 兩階段時間軸 ── */
  .line { list-style: none; margin: 0; padding: 0; }
  .ph { display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--space-8); }

  .ph__rail { position: relative; display: flex; justify-content: center; }
  .ph__rail::before {
    content: ''; position: absolute; top: 0; bottom: 0; width: 2px;
    background: var(--color-brand-200);
  }
  .ph:first-child .ph__rail::before { top: 1.6rem; }
  .ph:last-child .ph__rail::before { bottom: auto; height: 1.6rem; }
  .ph__dot {
    position: relative; margin-top: 1.1rem;
    width: 18px; height: 18px; border-radius: var(--radius-full);
    background: var(--color-white); border: 4px solid var(--color-brand-500);
  }
  .ph--open .ph__dot { border-color: var(--color-warm-500); }

  .ph__body { padding-bottom: var(--space-24); }
  .ph:last-child .ph__body { padding-bottom: 0; }

  .ph__meta {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: var(--space-3); margin-bottom: var(--space-3);
  }
  .ph__n {
    font-size: var(--text-2xl); font-weight: 900; line-height: 1;
    color: var(--color-brand-200); font-variant-numeric: tabular-nums;
  }
  .ph__status {
    font-size: var(--text-xs); font-weight: var(--font-bold); letter-spacing: .08em;
    padding: 2px var(--space-3); border-radius: var(--radius-full);
  }
  .ph__status--done { background: var(--color-ink-100); color: var(--color-ink-700); }
  .ph__status--open { background: var(--color-warm-500); color: var(--color-white); }
  .ph__span {
    font-size: var(--text-sm); color: var(--color-ink-500);
    font-variant-numeric: tabular-nums; letter-spacing: .02em;
  }

  .ph__title { font-size: var(--text-2xl); margin-bottom: var(--space-1); }
  .ph__sub { color: var(--color-brand-700); font-weight: var(--font-bold); margin-bottom: var(--space-4); }
  .ph__lede {
    max-width: var(--container-narrow); color: var(--color-ink-700);
    line-height: var(--leading-loose); margin-bottom: var(--space-6);
  }

  .facts {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4); margin: 0 0 var(--space-8);
    border-top: 1px solid var(--color-ink-300); padding-top: var(--space-4);
    max-width: 46rem;
  }
  .facts > div { display: grid; gap: var(--space-1); }
  .facts dt { font-size: var(--text-xs); color: var(--color-ink-500); }
  .facts dd {
    margin: 0; font-weight: var(--font-bold); color: var(--color-ink-900);
    font-variant-numeric: tabular-nums; font-size: var(--text-base);
  }
  .ph__figure { margin: 0 0 var(--space-8); max-width: 46rem; }
  .ph__figure img {
    width: 100%;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
  }
  .ph__figure figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-ink-500);
  }
  .ph__cta { margin: 0; }

  /* ── 為什麼 ── */
  .why { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-12); }
  .why p { color: var(--color-ink-700); line-height: var(--leading-loose); max-width: 46rem; }
  .why__links { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); align-content: start; }
  .why__links a { font-weight: var(--font-bold); text-decoration: none; }
  .why__links a:hover { text-decoration: underline; }

  @media (max-width: 860px) {
    .ph { grid-template-columns: 1.5rem minmax(0, 1fr); gap: var(--space-4); }
    .ph__body { padding-bottom: var(--space-16); }
    .facts { grid-template-columns: repeat(2, 1fr); }
    .why { grid-template-columns: 1fr; gap: var(--space-8); }
  }
</style>
