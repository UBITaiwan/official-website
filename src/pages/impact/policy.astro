---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

// 青年基本收入：政策方向
//
// 2026-08 新增。這頁存在的理由：協會投入最多的政策工作，
// 過去只散見於 2025 年度報告的一個段落，等於沒有可見度。
//
// 內容範圍：2026-08 協會回覆「最理想是整份簡報都可以放進去，
// 拋磚引玉就是我們的最大補丁，錯了也沒關係」，因此完整政策設計已納入，
// 並依協會建議採折疊呈現（前半段是論述，折疊區是完整設計）。
//
// 這解除了本頁最初「只講問題意識與政策方向」的限制——那是上線第一版的
// 暫行範圍，現已由內容擁有者授權放寬。
//
// 所有數字均逐項核算過與簡報一致：八項財源合計正好 8,210 億；
// 500 萬人 × 15,515 元 × 12 個月 = 9,309 億（簡報標示 9,310 億）；
// 缺口 1,100 億、分級收回回收 1,150 億。
//
// 資料來源：docs/new-input/Youth UBI Policy Proposal Tailor-made for Taiwan_2026 BIEN Congress.pdf
// 與 Indo-Pacific Basic Income Summit 2027 in Taiwan.pdf
// （UBI Taiwan 於 2026 BIEN Congress Toronto 發表，2026/08/20）。
//
// 普發現金年份經協會 2026-08 確認為 2023 與 2025 兩次，領取率皆超過 99%。

// 三個結構性挑戰。數字皆為政府公開統計，屬於「問題描述」，
// 不涉及提案的財源主張。
//
// 圖表全部改為原生 SVG（協會 2026-08 要求「圖表樣式要像簡報那樣」）。
// 數值一律取自 2026 BIEN 簡報（協會指正：先前誤用 2025 版），且只畫簡報中
// 實際標示的數字——沒有逐年資料的部分不重畫曲線，改以倍數長條或
// 指數化斜線呈現，避免捏造出我沒有的時間序列。
//
// 少子化預算與生育率單位不同，刻意不做雙軸，改為同以 2018 年為 100 的指數。
//
// 註：簡報第 17 頁把生育率 1.06→0.695 標為「▼18%」，與其自身數據不符
// （實算 −34.4%），第 16 頁標的「▼35%」才正確。本頁採 35%，已回報協會。
// en 欄位是協會簡報中自創的英文標題，保留作為出處標記。
const challenges = [
  {
    key: 'ai',
    n: '01',
    en: 'AI & Robotics',
    title: 'AI 正在抽掉年輕人的第一階',
    sum: '入門白領職缺跨產業消失，多數年輕人的職涯階梯正在快速不見。',
    lede: '被自動化取代的不再只是重複性勞動，而是年輕人賴以入行的那一階。',
    body: [
      'AI 對就業的衝擊，最先落在入門職缺上。Anthropic 執行長 Dario Amodei 公開警告，AI 可能在五年內取代半數的入門白領工作。對已經有資歷的人來說，那是工具；對剛要進入職場的人來說，那是消失的第一階。',
      '台灣的位置讓這件事更直接：我們生產全球超過六成的半導體、約九成的先進邏輯與 AI 晶片。台灣站在 AI 革命的正中心。科技業與資本已經為那個未來做好準備，但社會的大多數人呢？',
    ],
    stat: { v: '50', unit: '%', l: '入門白領工作可能在五年內被 AI 取代' },
    chart: null,
  },
  {
    key: 'wage',
    n: '02',
    en: 'Gen-Hopeless',
    title: '經濟成長了，薪水沒有',
    sum: '實質薪資長期停滯，勞動階級看不到翻轉的希望。',
    lede: '四十五年來，台灣的實質 GDP 成長了 8.3 倍，實質經常性薪資只成長 2.6 倍。',
    body: [
      '更嚴重的是，這條線在近二十多年幾乎是平的。把時間收斂到最近二十年來看，同一段期間裡房價漲了 4.1 倍、股市漲了 6.4 倍、人均實質 GDP 也有 2.3 倍。資產都在成長，只是不成長在薪水上。',
      '這個落差對年輕世代最殘酷。依勞退基金統計，25 歲以下的勞工有 57% 領不到基本工資；30 歲以下是 36.8%，35 歲以下是 30.5%，都高於全年齡的 25%。越年輕，處境越差。',
      '家庭財富的差距也在拉開：最富有的 20% 與最貧窮的 20%，資產差距從 1991 年的 16.8 倍擴大到 2021 年的 66.9 倍。',
    ],
    stat: { v: '57', unit: '%', l: '25 歲以下勞工領不到基本工資' },
    chart: 'multiple',
  },
  {
    key: 'birth',
    n: '03',
    en: 'Social Crisis',
    title: '不是不想生，是不敢想',
    sum: '連續 67 個月死亡多於出生，年輕人正在放棄婚姻與生育。',
    lede: '2025 年台灣的生育率降到 0.695，是全世界最低，已經低於韓國。',
    body: [
      '台灣連續 67 個月死亡人數多於出生人數。新生兒數量從 2018 年到 2025 年減少超過四成，2026 年預計首次跌破十萬人。',
      '政府不是沒有努力。少子化相關的年度預算在同一段期間成長了 4.9 倍，從 257 億元增加到超過 1,254 億元，但生育率仍然下降了 35%。這說明問題不在補助的多寡，而在年輕人對未來的整體信心。當生活本身沒有餘裕，生養下一代就不會進入選項。',
    ],
    stat: { v: '0.695', unit: '', l: '2025 年生育率，全球最低' },
    chart: 'budget',
  },
];

// 政策方向：為什麼從青年開始
const directions = [
  {
    t: '職涯轉換的緩衝',
    d: '當入門職缺正在消失，年輕人需要的不是更多競爭，而是一段能夠轉職、進修、甚至失敗的餘裕。基本收入提供的是承擔風險的本錢。',
  },
  {
    t: '社會流動與世代公平',
    d: '在資產快速集中的結構下，靠薪水已經很難翻身。無條件的基本給付，是把成長的果實重新分配一部分回到起步階段的人身上。',
  },
  {
    t: '育兒的安全網',
    d: '直接減輕養育的經濟壓力，也重建年輕世代對未來的信心。願不願意生養下一代，取決於對自己人生的預期，而不只是一次性的生育獎勵。',
  },
];

// ── 完整政策設計（折疊區）──────────────────────────────
// 依協會授權納入。這是提案，不是定案；協會自己的定位是「拋磚引玉」。

// 財源：八項，合計 8,210 億元／年（2028 年度規劃）
const funding = [
  { l: '營業稅', v: 3700, now: '5%', to: '8%', who: '企業', why: '台灣長期停在 5%，低於多數亞洲鄰國' },
  { l: '資本利得稅', v: 1280, now: '12%', to: '15%', who: '法人投資者', why: '最低稅負制稅率低於國際水準' },
  { l: '地價稅', v: 1020, now: '公告地價為市價 19.6%', to: '提高至 40%', who: '土地所有人', why: '公告地價長期低估，形成實質稅負不均' },
  { l: '主權基金', v: 600, now: '尚未設立', to: '3 兆規模、撥用 2% 報酬', who: '基金投資收益', why: '參考阿拉斯加模式，長期公共收益' },
  { l: '碳稅', v: 600, now: '碳費制度', to: '每噸 300 元、擴大範圍', who: '排碳企業', why: '符合國際趨勢與污染者付費原則' },
  { l: '當沖稅', v: 550, now: '0.15%', to: '0.30%', who: '當日沖銷交易者', why: '回歸市場常態，取消暫時性優惠' },
  { l: '債券交易稅', v: 320, now: '0%', to: '0.10%', who: '法人投資者', why: '長期免稅缺乏正當性' },
  { l: '土地增值稅', v: 140, now: '81.9% 的移轉免稅', to: '非農業使用納入課稅', who: '土地所有人', why: '嚴格審查農地免稅，落實租稅公平' },
];

// 分級稅收回機制：發放時人人有份，報稅季依所得級距回收
const taxback = [
  { tier: 'A', share: '60%', income: '50 萬元以下', back: '0%' },
  { tier: 'B', share: '23%', income: '50–70 萬元', back: '20%' },
  { tier: 'C', share: '14%', income: '70–100 萬元', back: '40%' },
  { tier: 'D', share: '3%',  income: '100 萬元以上', back: '60%' },
];
---

<BaseLayout
  title="青年基本收入：政策方向｜UBI Taiwan"
  description="UBI Taiwan 主張以 18–35 歲青年作為基本收入在台灣上路的起點。面對 AI 對入門職缺的衝擊、二十年的薪資停滯與全球最低的生育率，我們認為年輕世代最需要、也最能說服社會。"
  current="impact-policy"
  ogImage="/images/LINE_ALBUM_UBI-Taiwan-Panel_260131_41.webp"
>
  <PageHero
    image="/images/LINE_ALBUM_UBI-Taiwan-Panel_260131_41.webp"
    alt="2025 BIEN 全球大會現場，UBI Taiwan 成員發表台灣青年基本收入政策提案，投影幕顯示 Youth Basic Income Policy Proposal for Taiwan"
    eyebrow="我們的行動"
    title="青年基本收入：政策方向"
    lead="實驗能證明基本收入對一個人有沒有用，但要讓它成為制度，得回答另一個問題：如果台灣要開始，該從哪裡開始？我們的答案是年輕世代。"
    focus="center 40%"
    width={1280} heightAttr={964}
  />

  <!-- ── 為什麼是現在 ─────────────────────────────────── -->
  <section class="section" aria-labelledby="why-title">
    <div class="container container--narrow">
      <h2 id="why-title" class="sec-title">為什麼我們開始談政策</h2>
      <div class="prose">
        <p>
          UBI Taiwan 從 2017 年開始推動基本收入，做過遊行、擺攤、出版、國際串聯，
          也完成了台灣第一場基本收入實驗。這些工作累積了理解與情感上的支持，
          但要真正改變什麼，還缺一步：進入政策的對話場域。
        </p>
        <p>
          我們必須有意識地從議題倡議走向政策影響。
          在生成式 AI 爆發性成長、結構性失業與分配失衡同時發生的此刻，
          「基本收入是否可行」第一次具備了被認真討論的社會條件。
        </p>
        <p class="lede">
          所以我們決定踏出關鍵一步：為台灣量身打造一套青年基本收入的政策論述，
          讓基本收入成為一個必須被回應的政策選項，而不只是一個理想。
        </p>
      </div>
    </div>
  </section>

  <!-- ── 執行摘要（引用協會 2026 簡報的深色三欄版式）───── -->
  <section class="summary" aria-labelledby="sum-title">
    <div class="container">
      <p class="summary__eyebrow">Problems &amp; Challenges — Executive Summary</p>
      <h2 id="sum-title" class="summary__q">台灣社會正在面對什麼？為什麼要談基本收入？</h2>

      <ol class="sum3">
        {/* ① AI：環圈圖。單一比例值，用環圈最直接 */}
        <li class="sum" style="background-image: linear-gradient(rgba(10,12,15,.87), rgba(10,12,15,.87)), url('/images/policy-bg/ai.webp')">
          <p class="sum__en">AI &amp; Robotics</p>
          <h3 class="sum__t"><span>AI 正在抽掉</span><span>年輕人的第一階</span></h3>
          <p class="sum__d">入門白領職缺跨產業消失，多數年輕人的職涯階梯正在快速不見。</p>

          <figure class="viz viz--donut">
            <svg viewBox="0 0 150 150" role="img"
                 aria-label="環圈圖：入門白領工作中，約 50% 可能在五年內被 AI 取代">
              <circle class="viz__track" cx="75" cy="75" r="58" />
              <circle class="viz__arc" cx="75" cy="75" r="58"
                      stroke-dasharray="182.2 364.4" transform="rotate(-90 75 75)">
                <title>50%</title>
              </circle>
              <text class="viz__big" x="75" y="82" text-anchor="middle">50%</text>
            </svg>
            <figcaption>入門白領工作可能在五年內被 AI 取代</figcaption>
          </figure>
        </li>

        {/* ② 低薪：長條圖。四個年齡層的同一個指標，長條最好比 */}
        <li class="sum" style="background-image: linear-gradient(rgba(10,12,15,.87), rgba(10,12,15,.87)), url('/images/policy-bg/wage.webp')">
          <p class="sum__en">Gen-Hopeless</p>
          <h3 class="sum__t"><span>經濟成長了，</span><span>薪水沒有</span></h3>
          <p class="sum__d">實質薪資長期停滯，勞動階級看不到翻轉的希望。</p>

          <figure class="viz">
            <p class="viz__cap">領不到基本工資的比例</p>
            <svg viewBox="0 0 260 150" role="img"
                 aria-label="長條圖：領不到基本工資的勞工比例，25 歲以下 57.0%、30 歲以下 36.8%、35 歲以下 30.5%、全年齡 25.0%">
              {[
                { l: '≤25 歲', v: 57.0 },
                { l: '≤30 歲', v: 36.8 },
                { l: '≤35 歲', v: 30.5 },
                { l: '全年齡', v: 25.0 },
              ].map((d, i) => {
                const x = 8 + i * 63;
                const h = (d.v / 60) * 96;
                return (
                  <>
                    <rect class="viz__bar" x={x} y={120 - h} width="34" height={h} rx="4">
                      <title>{d.l}：{d.v}%</title>
                    </rect>
                    <text class="viz__val" x={x + 17} y={120 - h - 7} text-anchor="middle">{d.v}%</text>
                    <text class="viz__lab" x={x + 17} y="138" text-anchor="middle">{d.l}</text>
                  </>
                );
              })}
              <line class="viz__base" x1="4" y1="120" x2="256" y2="120" />
            </svg>
            <figcaption>越年輕，領不到基本工資的比例越高</figcaption>
          </figure>
        </li>

        {/* ③ 少子化：斜線圖。只有頭尾兩個實際數字，就只畫兩點 */}
        <li class="sum" style="background-image: linear-gradient(rgba(10,12,15,.87), rgba(10,12,15,.87)), url('/images/policy-bg/birth.webp')">
          <p class="sum__en">Social Crisis</p>
          <h3 class="sum__t"><span>不是不想生，</span><span>是不敢想</span></h3>
          <p class="sum__d">連續 67 個月死亡多於出生，年輕人正在放棄婚姻與生育。</p>

          <figure class="viz">
            <p class="viz__cap">新生兒數（千人）</p>
            <svg viewBox="0 0 260 150" role="img"
                 aria-label="斜線圖：新生兒數從 2018 年的 18 萬 1,600 人降至 2025 年的 10 萬 7,800 人，減少四成">
              <line class="viz__base" x1="30" y1="122" x2="240" y2="122" />
              <line class="viz__slope" x1="52" y1="30" x2="216" y2="98" />
              <circle class="viz__dot" cx="52" cy="30" r="6"><title>2018 年 181.6 千人</title></circle>
              <circle class="viz__dot" cx="216" cy="98" r="6"><title>2025 年 107.8 千人</title></circle>
              <text class="viz__val" x="52" y="18" text-anchor="middle">181.6</text>
              <text class="viz__val" x="216" y="88" text-anchor="middle">107.8</text>
              <text class="viz__lab" x="52" y="140" text-anchor="middle">2018</text>
              <text class="viz__lab" x="216" y="140" text-anchor="middle">2025</text>
              <text class="viz__delta" x="134" y="76" text-anchor="middle">▼ 四成</text>
            </svg>
            <figcaption>2026 年預計首次跌破十萬人</figcaption>
          </figure>
        </li>
      </ol>

      <p class="summary__src">
        資料來源：政府公開統計（勞動部、勞退基金、內政部、衛福部、國家發展委員會）
      </p>
    </div>
  </section>

  <!-- ── 三個問題的詳述 ───────────────────────────────── -->
  <section class="section section--subtle" aria-labelledby="challenge-title">
    <div class="container">
      <h2 id="challenge-title" class="sec-title">這三件事，其實是同一個結構</h2>
      <p class="sec-lead">
        它們各自都被討論過，但承受最重的是同一群人：剛進入職場、正在決定要不要成家的年輕世代。
      </p>

      <ol class="challenges">
        {challenges.map((c) => (
          <li class={`ch ch--${c.key}`}>
            <div class="ch__head">
              <span class="ch__n" aria-hidden="true">{c.n}</span>
              <div>
                <h3 class="ch__title">{c.title}</h3>
                <p class="ch__lede">{c.lede}</p>
              </div>
            </div>
            <div class="ch__body">
              <div class="ch__prose">
                {c.body.map((p) => <p>{p}</p>)}
              </div>
              <figure class={`mini mini--${c.key}`} data-anim>
                {c.key === 'ai' && (
                  <svg viewBox="0 0 150 150" role="img"
                       aria-label="環圈圖：入門白領工作中，約 50% 可能在五年內被 AI 取代">
                    <circle class="mini__track" cx="75" cy="75" r="58" />
                    <circle class="mini__arc" cx="75" cy="75" r="58"
                            stroke-dasharray="182.2 364.4" transform="rotate(-90 75 75)">
                      <title>50%</title>
                    </circle>
                    <text class="mini__big" x="75" y="83" text-anchor="middle">50%</text>
                  </svg>
                )}

                {c.key === 'wage' && (
                  <svg viewBox="0 0 260 150" role="img"
                       aria-label="長條圖：領不到基本工資的勞工比例，25 歲以下 57.0%、30 歲以下 36.8%、35 歲以下 30.5%、全年齡 25.0%">
                    {[
                      { l: '≤25 歲', v: 57.0 },
                      { l: '≤30 歲', v: 36.8 },
                      { l: '≤35 歲', v: 30.5 },
                      { l: '全年齡', v: 25.0 },
                    ].map((d, i) => {
                      const x = 8 + i * 63;
                      const h = (d.v / 60) * 96;
                      return (
                        <>
                          <rect class="mini__bar" x={x} y={120 - h} width="34" height={h} rx="4"
                                style={`--d:${i * 110}ms`}>
                            <title>{d.l}：{d.v}%</title>
                          </rect>
                          <text class="mini__val" x={x + 17} y={120 - h - 7} text-anchor="middle"
                                style={`--d:${i * 110 + 260}ms`}>{d.v}%</text>
                          <text class="mini__lab" x={x + 17} y="138" text-anchor="middle">{d.l}</text>
                        </>
                      );
                    })}
                    <line class="mini__base" x1="4" y1="120" x2="256" y2="120" />
                  </svg>
                )}

                {c.key === 'birth' && (
                  <svg viewBox="0 0 260 150" role="img"
                       aria-label="斜線圖：新生兒數從 2018 年的 18 萬 1,600 人降至 2025 年的 10 萬 7,800 人，減少四成">
                    <line class="mini__base" x1="30" y1="122" x2="240" y2="122" />
                    <line class="mini__slope" x1="52" y1="30" x2="216" y2="98" />
