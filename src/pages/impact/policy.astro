  .mini__bar { fill: var(--deck-gold); }
  .mini__base { stroke: rgba(255,255,255,.28); stroke-width: 1.5; }
  .mini__slope { stroke: var(--deck-gold); stroke-width: 3; stroke-linecap: round; }
  .mini__dot { fill: var(--deck-gold); }
  .mini__val {
