<script>
  // 詳述區小圖：進入視窗時繪出，之後每 10 秒重播一次。
  //
  // 漸進增強：隱藏狀態（.is-armed）只由這段程式碼加上，所以 JS 失效時
  // 圖表本來就是完成狀態，只是不會動——不影響閱讀。
  // prefers-reduced-motion 時完全不武裝：直接顯示，也不重播。
  //
  // 用單一全域計時器輪播「目前在視窗內」的圖，而不是每張圖各自計時。
  // 這樣即使 IntersectionObserver 沒有如期回報（headless、極端捲動時序），
  // 保險機制也能把圖標記為可見並讓重播照常運作——先前把迴圈綁在 IO 的
  // 回呼裡，IO 一旦沒觸發，圖雖然會顯示但永遠不會動。
  const REPLAY_MS = 10000;
  const figs = Array.from(document.querySelectorAll<HTMLElement>('.mini[data-anim]'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (figs.length && !reduce) {
    const visible = new Set<HTMLElement>();

    // 重播一次。分成兩個影格：先在「過渡已關閉」的狀態下瞬間歸零，
    // 下一個影格才把過渡打開並設回終點，瀏覽器才會真的重跑動畫。
    const play = (el: HTMLElement) => {
      el.classList.add('is-reset');
      el.classList.remove('is-in');
      void el.getBoundingClientRect();        // 讓歸零立即生效
      requestAnimationFrame(() => {
        el.classList.remove('is-reset');
        void el.getBoundingClientRect();      // 過渡恢復後再讀一次
        el.classList.add('is-in');
      });
    };

    figs.forEach((f) => f.classList.add('is-armed'));

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const el = e.target as HTMLElement;
            if (e.isIntersecting) {
              if (!visible.has(el)) { visible.add(el); play(el); }
            } else {
              visible.delete(el);
            }
          });
        },
        { threshold: 0.35 }
      );
      figs.forEach((f) => io.observe(f));
    }

    // 保險：2 秒後仍未被標記為可見的圖，一律顯示並納入重播，
    // 不留下空白的圖，也不留下永遠不動的圖。
    window.setTimeout(() => {
      figs.forEach((f) => {
        if (!visible.has(f)) { visible.add(f); f.classList.add('is-in'); }
      });
    }, 2000);

    // 單一計時器：只重播看得到的圖；分頁在背景時整輪跳過。
    window.setInterval(() => {
      if (document.hidden) return;
      visible.forEach((el) => play(el));
    }, REPLAY_MS);
  }
</script>

<style>
