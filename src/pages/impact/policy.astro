    transition: transform .8s var(--ease-out) var(--d, 0ms);
  }
  .mini.is-armed.is-in .mini__bar { transform: scaleY(1); }

  .mini.is-armed .mini__slope {
    stroke-dasharray: 200; stroke-dashoffset: 200;
    transition: stroke-dashoffset 1s var(--ease-out) .1s;
  }
  .mini.is-armed.is-in .mini__slope { stroke-dashoffset: 0; }

  .mini.is-armed .mini__dot {
    opacity: 0; transition: opacity .4s var(--ease-out) var(--d, 0ms);
