---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ubi from '../../data/ubi-content.json';

// 全球進程：13 個案例，分政策制度／倡議行動／實驗成果三類。
// 規格要求說明文字預設隱藏、點擊展開，並已明確否決在頁首放分類導覽表格
// （理由是內容既已摺疊）。因此這裡不做表格，改以一條時間軸式的索引軌，
// 讓 13 筆的年份分布一眼可見——那是表格給不了的資訊。

const groups = [
  { key: 'policy', label: '政策與社會制度', note: '已經在實施的制度' },
  { key: 'advocacy', label: '倡議行動', note: '推動制度的公民與政治行動' },
  { key: 'experiments', label: '實驗成果', note: '有對照組的科學驗證' },
] as const;

const world = ubi.world as Record<string, Array<{
  title: string; paras: string[]; bullets?: string[]; year: string; place: string; cc: string;
}>>;

// 依起始年份排序，供索引軌呈現時間分布
const all = groups.flatMap((g) =>
  world[g.key].map((c, i) => ({ ...c, group: g.key, label: g.label, slug: `${g.key}-${i}` }))
);
const sorted = [...all].sort((a, b) => parseInt(a.year) - parseInt(b.year));
---

<BaseLayout
  title="全球進程：基本收入在世界各地｜UBI Taiwan"
  description="從 1982 年的阿拉斯加永久基金到 2025 年的馬紹爾群島，13 個基本收入的政策、倡議與實驗案例，涵蓋澳門、愛爾蘭、瑞士、南韓、肯亞、芬蘭、加拿大、美國與印度。"
  current="ubi-world"
>
  <section class="head">
    <div class="container">
      <p class="eyebrow">認識基本收入</p>
      <h1>全球進程</h1>
      <p class="head__lead">
        基本收入不是紙上的理論。從 1982 年阿拉斯加開始發放石油分紅，到 2025 年馬紹爾群島啟動全國計畫，
        43 年間累積了實施中的制度、推動制度的行動，以及帶對照組的科學實驗。
      </p>

      <!--
        案例年表。改為左右捲動的軌道：
        原本 13 筆平分整個版面寬度，越加越擠，行動裝置上更難讀。
        現在每張卡片固定寬度、軌道橫向捲動，之後新增案例只會加長軌道，
        不會壓縮既有卡片。年份在線上、圓點落在線上、卡片在線下並上下交錯，
        交錯是為了讓相鄰卡片即使靠近也不會互相干擾。
      -->
      <nav class="rail" aria-label="案例年表">
        <div class="rail__scroll" tabindex="0" aria-label="案例年表，可左右捲動">
          <ol class="rail__track">
            {sorted.map((c, i) => (
              <li class:list={['stop', `stop--${c.group}`, { 'stop--low': i % 2 === 1 }]}>
                <a href={`#${c.slug}`}>
                  <span class="stop__year">{c.year}</span>
                  <span class="stop__dot" aria-hidden="true"></span>
                  <span class="stop__card">
                    <span class="stop__title">{c.title}</span>
                    <span class="stop__place">
                      <img class="flag" src={`/images/flags/${c.cc}.svg`} alt="" width="24" height="18" loading="lazy" />{c.place}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <p class="rail__hint" aria-hidden="true">左右滑動看完整年表</p>
      </nav>
      <ul class="legend">
        {groups.map((g) => (
          <li class={`legend__item legend__item--${g.key}`}>
            <span class="legend__dot" aria-hidden="true"></span>
            {g.label}
            <b>{world[g.key].length}</b>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {groups.map((g) => (
    <section class="section" aria-labelledby={`g-${g.key}`}>
      <div class="container">
        <div class={`grp grp--${g.key}`}>
          <h2 id={`g-${g.key}`}>{g.label}</h2>
          <p class="grp__note">{g.note}</p>
        </div>

        <div class="cases">
          {world[g.key].map((c, i) => (
            <details class="case" id={`${g.key}-${i}`}>
              <summary>
                <span class="case__meta">
                  <span class="case__year">{c.year}</span>
                  <span class="case__place">
                    <img class="flag" src={`/images/flags/${c.cc}.svg`} alt="" width="26" height="20" loading="lazy" />{c.place}
                  </span>
                </span>
                <span class="case__title">{c.title}</span>
                <span class="case__chev" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="16" height="16" fill="none"
                       stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M3 6l5 5 5-5" />
                  </svg>
                </span>
              </summary>
              <div class="case__body">
                {c.paras.map((p) => <p>{p}</p>)}
                {c.bullets && (
                  <ul class="case__bullets">
                    {c.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section section--muted">
    <div class="container">
      <ul class="next">
        <li><a href="/ubi/faq/"><span class="next__label">基本收入大哉問</span><span class="next__desc">看完別人怎麼做，接著看最常見的 14 個疑問。</span></a></li>
        <li><a href="/experiment/"><span class="next__label">台灣的實驗</span><span class="next__desc">回到台灣：UBI Taiwan 做了什麼、結果如何。</span></a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .head { padding-block: var(--space-16) var(--space-8); background: var(--surface-subtle); }
  .head__lead {
    max-width: var(--container-narrow);
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    color: var(--color-ink-700);
    margin-bottom: var(--space-12);
  }

  /* ── 年表索引軌（左右捲動）── */
  /*
    三個分類各一個色相：紫／橘／綠。
    政策原本用 brand 藍，但這一區的底色是 brand-50（淺藍），藍卡片會糊進背景；
    實驗原本用 accent 藍，與 brand 藍取樣差不到 2%，肉眼分不出。
    三色已於 2026-08 正式進 tokens（--color-cat-*），不再借用語意色。
  */
  .rail { margin-bottom: var(--space-4); --stagger: 5rem; }
  .stop--policy      { --cat: var(--color-cat-policy); }
  .stop--advocacy    { --cat: var(--color-cat-advocacy); }
  .stop--experiments { --cat: var(--color-cat-experiment); }

  .rail__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    /* 捲動容器要能被鍵盤聚焦與操作 */
    scrollbar-width: thin;
    padding-bottom: var(--space-2);
  }
  .rail__scroll:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  .rail__track {
    position: relative;
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0 var(--space-2) var(--space-8);
    width: max-content;
  }
  /* 時間軸的線：年份列 28px + 圓點列一半 7px = 35px */
  .rail__track::before {
    content: '';
    position: absolute;
    top: 35px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-brand-200);
  }

  .stop { scroll-snap-align: start; }
  .stop > a {
    display: grid;
    grid-template-rows: 28px 14px auto;
    justify-items: center;
    width: 13.5rem;
    text-decoration: none;
    color: var(--color-ink-900);
  }

  .stop__year {
    align-self: end;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-500);
    white-space: nowrap;
    transition: color var(--duration-base) var(--ease-out);
  }

  .stop__dot {
    align-self: center;
    width: 13px;
    height: 13px;
    border-radius: var(--radius-full);
    background: var(--cat);
    border: 2px solid var(--color-white);
    box-shadow: 0 0 0 1px var(--cat);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .stop__card {
    position: relative;
    display: grid;
    gap: var(--space-1);
    width: 100%;
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-top: 3px solid var(--cat);
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: color-mix(in srgb, var(--cat) 13%, var(--color-white));
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out);
  }
  /* 從圓點垂下的接線，交錯之後仍看得出卡片屬於哪個點 */
  .stop__card::before {
    content: '';
    position: absolute;
    left: 50%;
    top: calc(var(--space-4) * -1);
    width: 1px;
    height: var(--space-4);
    background: var(--cat);
    opacity: .55;
  }
  /* 上下交錯：奇數項往下掉一段，相鄰卡片就不會互相干擾 */
  .stop--low .stop__card { margin-top: var(--stagger); }
  .stop--low .stop__card::before {
    top: calc(var(--stagger) * -1);
    height: var(--stagger);
  }

  .stop__title {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    line-height: 1.45;
    text-wrap: balance;
  }
  .stop__place {
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  /*
    國旗改用 SVG 圖檔（public/images/flags/，取自 flag-icons，MIT）。
    先前用 Unicode 國旗字元，但 Windows 的預設表情字型不支援，會顯示成兩個字母。
    地點名稱本身就是文字，旗子只是輔助，因此 alt="" 讓讀屏略過，不重複念。
  */
  .flag {
    flex: none;
    width: 24px;
    height: 18px;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgba(26, 36, 48, 0.12);
  }
  .case__place .flag { width: 26px; height: 20px; }

  .stop > a:hover .stop__card,
  .stop > a:focus-visible .stop__card {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .stop > a:hover .stop__dot { transform: scale(1.35); }
  .stop > a:hover .stop__year { color: var(--color-ink-900); }

  .rail__hint {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-ink-500);
    letter-spacing: 0.04em;
  }
  .rail__hint::before { content: '← '; }
  .rail__hint::after { content: ' →'; }

  @media (prefers-reduced-motion: reduce) {
    .rail__scroll { scroll-snap-type: none; }
    .stop > a:hover .stop__card,
    .stop > a:hover .stop__dot { transform: none; }
  }
  @media (max-width: 560px) {
    .stop > a { width: 11rem; }
  }

  .legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    margin: var(--space-6) 0 0;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-700);
  }
  .legend__item { display: flex; align-items: center; gap: var(--space-2); }
  .legend__dot { width: 10px; height: 10px; border-radius: var(--radius-full); }
  .legend__item--policy .legend__dot { background: var(--color-cat-policy); }
  .legend__item--advocacy .legend__dot { background: var(--color-cat-advocacy); }
  .legend__item--experiments .legend__dot { background: var(--color-cat-experiment); }
  .legend b {
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-500);
    font-weight: var(--font-medium);
  }

  /* ── 分類標頭 ── */
  .grp {
    border-left: 4px solid var(--color-cat-policy);
    padding-left: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .grp--advocacy { border-left-color: var(--color-cat-advocacy); }
  .grp--experiments { border-left-color: var(--color-cat-experiment); }
  .grp h2 { margin-bottom: var(--space-1); }
  .grp__note { margin: 0; color: var(--color-ink-500); font-size: var(--text-sm); }

  /* ── 案例摺疊 ── */
  .cases { display: grid; }
  /* sticky header 約 73px，錨點跳轉需留出空間，否則標題會被蓋住 */
  .case { border-top: 1px solid var(--color-ink-300); scroll-margin-top: 6rem; }
  .case:last-child { border-bottom: 1px solid var(--color-ink-300); }

  .case summary {
    display: grid;
    grid-template-columns: 11rem 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-6) var(--space-2) var(--space-6) 0;
    cursor: pointer;
    list-style: none;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .case summary::-webkit-details-marker { display: none; }
  .case summary:hover { background: var(--surface-subtle); }

  .case__meta { display: grid; gap: 2px; }
  .case__year {
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-brand-700);
  }
  .case__place { font-size: var(--text-xs); color: var(--color-ink-500); display: flex; align-items: center; gap: var(--space-2); }
  .case__title { font-size: var(--text-xl); font-weight: var(--font-bold); text-wrap: balance; }
  .case__chev {
    color: var(--color-ink-500);
    transition: transform var(--duration-base) var(--ease-out);
    align-self: center;
  }
  .case[open] .case__chev { transform: rotate(180deg); }
  /* 從年表跳過來時短暫標示，讓人知道落在哪一筆 */
  .case.is-target > summary { background: color-mix(in srgb, var(--color-brand-500) 14%, var(--color-white)); }
  .case > summary { transition: background var(--duration-base) var(--ease-out); }
  .case[open] .case__title { color: var(--color-brand-700); }

  .case__body {
    padding: 0 var(--space-8) var(--space-8) 11rem;
    max-width: 62rem;
    color: var(--color-ink-700);
    line-height: var(--leading-loose);
  }
  .case__body p:last-child { margin-bottom: 0; }
  .case__bullets { margin: 0 0 var(--space-4); padding-left: var(--space-6); }
  .case__bullets li { margin-bottom: var(--space-2); }

  /* ── 下一步 ── */
  .next { list-style: none; margin: 0; padding: 0; }
  .next a {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: var(--space-2) var(--space-8);
    align-items: baseline;
    padding: var(--space-6) var(--space-4) var(--space-6) 0;
    border-top: 1px solid var(--color-ink-300);
    text-decoration: none;
    color: var(--color-ink-900);
    transition: padding-left var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out);
  }
  .next li:last-child a { border-bottom: 1px solid var(--color-ink-300); }
  .next a:hover { padding-left: var(--space-4); background: var(--color-white); }
  .next__label { font-size: var(--text-xl); font-weight: var(--font-bold); color: var(--color-brand-700); }
  .next__label::after { content: ' →'; }
  .next__desc { color: var(--color-ink-700); }

  @media (max-width: 860px) {
    .case summary { grid-template-columns: 1fr auto; }
    .case__meta { grid-column: 1 / -1; display: flex; gap: var(--space-3); }
    .case__body { padding-left: 0; padding-right: 0; }
    .next a { grid-template-columns: 1fr; }
  }
</style>

<script>
  // 點年表卡片：捲到下方對應案例並展開它。
  // 只靠原生 #錨點 會有兩個問題——目標被 sticky header 蓋住（已用 scroll-margin 解決），
  // 以及摺疊區仍是關的，使用者跳過去只看到標題，沒有「點了有反應」的感覺。
  const cases = document.querySelectorAll<HTMLDetailsElement>('.case');

  function revealCase(id: string, smooth = true) {
    const target = document.getElementById(id);
    if (!(target instanceof HTMLDetailsElement)) return false;
    target.open = true;
    target.scrollIntoView({
      block: 'start',
      behavior: smooth && !matchMedia('(prefers-reduced-motion: reduce)').matches ? 'smooth' : 'auto',
    });
    // 短暫highlight，讓人知道跳到哪一筆
    target.classList.add('is-target');
    window.setTimeout(() => target.classList.remove('is-target'), 1600);
    return true;
  }

  document.querySelectorAll<HTMLAnchorElement>('.stop > a').forEach((link) => {
    link.addEventListener('click', (e) => {
      const id = link.getAttribute('href')?.slice(1);
      if (!id) return;
      if (revealCase(id)) {
        e.preventDefault();
        history.replaceState(null, '', `#${id}`);
      }
    });
  });

  // 直接帶 #錨點進站時也要展開
  if (location.hash) revealCase(location.hash.slice(1), false);
  window.addEventListener('hashchange', () => revealCase(location.hash.slice(1)));
</script>
