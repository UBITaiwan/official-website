---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ubi from '../../data/ubi-content.json';

// 基本收入大哉問：14 題，取代改版前只有 3 題的 /qa/。
// 文案逐字取自團隊規格（docs/content-specs/01-what-is-ubi.md）。
// 每題有獨立錨點（#q1…#q14），可單獨分享；FAQPage 結構化資料讓單題能被搜尋到——
// 這也是把大哉問獨立成頁、而非併入單一長頁的主要理由之一。

const faq = ubi.faq as Array<{ q: string; paras: string[] }>;

/*
  「你可能也這樣想過」：把讀者心裡的話先講出來，再進入問答。
  參考 visionzero.tw 的手法——他們在說明政策之前，先列出六個你認得的日常場景。
  差別在於他們列的是「共同經驗」（作用是結盟），這裡列的是「常見疑慮」
  （作用是表明不迴避）；結盟式的寫法首頁的三個自問已經在做，不重複。

  這六句經 UBI Taiwan 於 2026-08 審閱通過，維持現狀。
*/
const doubts = [
  { say: '發錢給大家，那誰還要工作？',        to: 'q1'  },
  { say: '錢從哪裡來？還不是從我們的稅金出。', to: 'q11' },
  { say: '連有錢人都發，這不是浪費嗎？',      to: 'q4'  },
  { say: '大家手上錢變多，東西就跟著漲，等於白發。', to: 'q10' },
  { say: '台灣已經有低收補助了，為什麼還要再發一次？', to: 'q8' },
  { say: '聽起來就是選舉支票，選完就沒了。',   to: 'q12' },
];

const faqJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.paras.join('\n') },
  })),
});
---

<BaseLayout
  title="基本收入大哉問｜UBI Taiwan"
  description="會讓人不想工作嗎？錢從哪裡來？會造成通膨嗎？為什麼要發給有錢人？14 個關於無條件基本收入最常見的疑問，逐題以實證研究回應。"
  current="ubi-faq"
>
  <!--
    開場即「你可能也這樣想過」。原本上方還有一段「被問得最多的十四個問題…」
    的導言，因語氣過於權威而拿掉——這頁的姿態是先聽，不是先教。
    「基本收入大哉問」保留為 eyebrow 與 <title>，維持頁面身分與導覽對應。
  -->
  <section class="section doubts" aria-labelledby="doubts-title">
    <div class="container">
      <p class="eyebrow">認識基本收入 · 基本收入大哉問</p>
      <h1 id="doubts-title">你可能也這樣想過</h1>
      <p class="doubts__lead">
        如果你對基本收入的第一個反應是懷疑，那很正常。
        下面這些話，我們在擺攤、演講、留言區聽過無數次——它們都是好問題。
      </p>

      <ul class="doubts__list">
        {doubts.map((d) => (
          <li class="doubt">
            <a href={`#${d.to}`}>
              <span class="doubt__say">{d.say}</span>
              <span class="doubt__go" aria-hidden="true">看回應</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="doubts__bridge">
        我們不打算用一句話說服你。<br />
        下面十四個問題，我們把各國實驗的實際數據一起放上來，你自己判斷。
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <nav class="toc" aria-label="問題索引">
        <p class="toc__label">全部十四題</p>
        <ol>
          {faq.map((f, i) => (
            <li>
              <a href={`#q${i + 1}`}>
                <span class="toc__n">{String(i + 1).padStart(2, '0')}</span>
                <span class="toc__q">{f.q}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="bar">
        <h2 id="faq-title" class="visually-hidden">問答</h2>
        <button type="button" class="bar__toggle" data-expand aria-pressed="false">全部展開</button>
      </div>

      <div class="faq">
        {faq.map((f, i) => (
          <details class="q" id={`q${i + 1}`}>
            <summary>
              <span class="q__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="q__t">{f.q}</span>
              <span class="q__chev" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="18" height="18" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M3 6l5 5 5-5" />
                </svg>
              </span>
            </summary>
            <div class="q__a">
              {f.paras.map((p) => <p>{p}</p>)}
              <p class="q__perma"><a href={`#q${i + 1}`}>連結到這一題</a></p>
            </div>
          </details>
        ))}
      </div>

      <nav class="more" aria-label="其他主題問答">
        <h2>其他主題的問答</h2>
        <ul>
          <li>
            <a href="/life-freedom/#lf-faq-title">關於「生活自由計畫」的問答 →</a>
            <span>報名資格、金額用途、退出機制</span>
          </li>
          <li>
            <a href="/support/#faq-title">關於捐款的問答 →</a>
            <span>收據、抵稅、定期定額、愛心碼</span>
          </li>
        </ul>
      </nav>
    </div>
  </section>

  <script type="application/ld+json" set:html={faqJsonLd} />
</BaseLayout>

<style>
  /*
    ── 你可能也這樣想過 ──
    呈現成「釘在板子上的紙條」：協會擺攤時就是用白板和紙卡收集大家的想法
    （見首頁「已經有人填過了」的現場照片），這六句正是從那些場合聽來的話，
    讓它們長得像被帶回來的紙條，出處和形式就對上了。
    不用假手寫字型——手寫感留給紙張的質地（微傾、膠帶、紙色），字就是字。
  */
  .doubts { background: var(--surface-subtle); padding-top: var(--space-16); }
  .doubts__lead {
    max-width: var(--container-narrow);
    color: var(--color-ink-700);
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    margin-bottom: var(--space-12);
  }

  .doubts__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8) var(--space-6);
  }

  .doubt a {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-6);
    height: 100%;
    min-height: 11rem;
    padding: var(--space-8) var(--space-6) var(--space-5);
    background: #FFFCF2;
    box-shadow: var(--shadow-sm);
    border-radius: 2px;
    text-decoration: none;
    color: var(--color-ink-900);
    transition: transform var(--duration-base) var(--ease-out),
                box-shadow var(--duration-base) var(--ease-out);
  }
  /* 每張紙條各自歪一點，像隨手釘上去的 */
  .doubt:nth-child(1) a { transform: rotate(-1.6deg); }
  .doubt:nth-child(2) a { transform: rotate(1.1deg); margin-top: var(--space-6); }
  .doubt:nth-child(3) a { transform: rotate(-0.7deg); }
  .doubt:nth-child(4) a { transform: rotate(1.4deg); }
  .doubt:nth-child(5) a { transform: rotate(-1.2deg); margin-top: var(--space-6); }
  .doubt:nth-child(6) a { transform: rotate(0.9deg); }

  /*
    頂端一截膠帶。先前用半透明白，在米色紙上幾乎看不見；
    改成帶一點品牌藍的半透明款（像紙膠帶），兩端用 clip-path 撕出毛邊，
    上緣一道高光做出膠面的反光。陰影改用 drop-shadow——
    clip-path 會把 box-shadow 一起裁掉，drop-shadow 才會沿著撕邊的形狀落影。
  */
  .doubt a::before {
    content: '';
    position: absolute;
    top: -13px;
    left: 50%;
    width: 88px;
    height: 28px;
    transform: translateX(-50%) rotate(-2.5deg);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0) 45%),
      rgba(212, 176, 66, 0.5);
    clip-path: polygon(
      2% 0, 98% 3%, 100% 28%, 97% 52%, 100% 76%, 98% 100%,
      3% 97%, 0 74%, 2% 48%, 0 22%
    );
    filter: drop-shadow(0 2px 3px rgba(26, 36, 48, 0.2));
  }
  .doubt:nth-child(even) a::before { transform: translateX(-50%) rotate(3deg); }

  /* 右下角捲起：對角分割的方塊，外半合入版面底色＝被掀開的缺口，
     內半是折過來的紙背（漸層：靠折線暗、翹起的尖端亮），加小陰影讓角浮起來 */
  .doubt a::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: 28px;
    height: 28px;
    background: linear-gradient(
      315deg,
      var(--surface-subtle) 0 50%,
      #E8DBB8 50%,
      #F6EFD9 100%
    );
    box-shadow: -2px -2px 3px rgba(26, 36, 48, 0.12);
  }

  .doubt__say {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    line-height: var(--leading-normal);
    text-wrap: balance;
  }
  .doubt__say::before { content: '「'; color: var(--color-cat-advocacy); }
  .doubt__say::after  { content: '」'; color: var(--color-cat-advocacy); }

  .doubt__go {
    align-self: flex-end;
    margin-right: var(--space-4); /* 讓開右下角的捲角 */
    font-size: var(--text-sm);
    color: var(--color-brand-600);
    transition: color var(--duration-base) var(--ease-out);
  }
  .doubt__go::after { content: ' →'; }

  /* hover：紙條擺正、微微抬起，像被拿起來看 */
  .doubt a:hover,
  .doubt a:focus-visible {
    transform: rotate(0deg) translateY(-5px);
    box-shadow: var(--shadow-md);
  }
  .doubt a:hover .doubt__go,
  .doubt a:focus-visible .doubt__go { color: var(--color-brand-700); }

  .doubts__bridge {
    margin: var(--space-16) 0 0;
    padding-top: var(--space-6);
    border-top: 2px solid var(--color-ink-300);
    max-width: var(--container-narrow);
    color: var(--color-ink-700);
    line-height: var(--leading-loose);
  }

  @media (prefers-reduced-motion: reduce) {
    .doubt a, .doubt:nth-child(n) a { transform: none; transition: none; }
    .doubt a:hover { transform: none; }
  }
  @media (max-width: 900px) {
    .doubts__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .doubt:nth-child(n) a { margin-top: 0; }
  }
  @media (max-width: 560px) {
    .doubts__list { grid-template-columns: 1fr; gap: var(--space-6); }
    .doubt a { min-height: 0; }
  }

  /* ── 問題索引 ── */
  .toc { margin-bottom: var(--space-8); }
  .toc__label {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-ink-500);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-8);
  }
  .toc li { break-inside: avoid; margin-bottom: var(--space-1); }
  .toc a {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-2) var(--space-2) var(--space-2) 0;
    text-decoration: none;
    color: var(--color-ink-700);
    border-radius: var(--radius-sm);
    transition: background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }
  .toc a:hover { background: var(--color-white); color: var(--color-brand-700); }
  .toc__n {
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-brand-500);
  }
  .toc__q { font-size: var(--text-sm); line-height: 1.5; }

  /* ── 展開控制 ── */
  .bar { display: flex; justify-content: flex-end; margin-bottom: var(--space-4); }
  .bar__toggle {
    font-family: inherit;
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-brand-700);
    background: transparent;
    border: 1px solid var(--color-brand-300);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-6);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .bar__toggle:hover { background: var(--color-brand-50); }

  /* ── 問答 ── */
  .faq { display: grid; }
  /* sticky header 約 73px，錨點跳轉需留出空間，否則題目會被蓋住 */
  .q { border-top: 1px solid var(--color-ink-300); scroll-margin-top: 6rem; }
  .q:last-of-type { border-bottom: 1px solid var(--color-ink-300); }
  .q summary {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-6) var(--space-2) var(--space-6) 0;
    cursor: pointer;
    list-style: none;
    transition: background var(--duration-fast) var(--ease-out);
  }
  .q summary::-webkit-details-marker { display: none; }
  .q summary:hover { background: var(--surface-subtle); }
  .q__n {
    font-variant-numeric: tabular-nums;
    font-size: var(--text-xl);
    font-weight: 900;
    color: var(--color-brand-200);
    line-height: 1;
    transition: color var(--duration-base) var(--ease-out);
  }
  .q__t { font-size: var(--text-xl); font-weight: var(--font-bold); text-wrap: balance; }
  .q__chev { color: var(--color-ink-500); align-self: center; transition: transform var(--duration-base) var(--ease-out); }
  .q[open] .q__chev { transform: rotate(180deg); }
  /* 從六句或索引跳過來時短暫標示，讓人知道落在哪一題 */
  .q > summary { transition: background var(--duration-base) var(--ease-out); }
  .q.is-target > summary { background: color-mix(in srgb, var(--color-brand-500) 14%, var(--color-white)); }
  .q[open] .q__n { color: var(--color-warm-500); }
  .q[open] .q__t { color: var(--color-brand-700); }

  .q__a {
    padding: 0 var(--space-8) var(--space-8) 3.5rem;
    max-width: 62rem;
    color: var(--color-ink-700);
    line-height: var(--leading-loose);
  }
  .q__perma { margin: var(--space-4) 0 0; font-size: var(--text-sm); }
  .q__perma a { color: var(--color-ink-500); text-decoration: none; }
  .q__perma a:hover { color: var(--color-brand-600); text-decoration: underline; }

  /* ── 其他主題 ── */
  .more { margin-top: var(--space-16); }
  .more h2 { font-size: var(--text-xl); margin-bottom: var(--space-4); }
  .more ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-4); }
  .more li { display: grid; gap: var(--space-1); }
  .more span { font-size: var(--text-sm); color: var(--color-ink-500); }

  @media (max-width: 860px) {
    .toc { margin-bottom: var(--space-8); }
  .toc__label {
    font-size: var(--text-sm);
    font-weight: var(--font-bold);
    color: var(--color-ink-500);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-3);
  }
  .toc ol { columns: 1; }
    .q summary { grid-template-columns: 2.5rem 1fr auto; gap: var(--space-3); }
    .q__a { padding: 0 0 var(--space-6) 2.5rem; }
  }
</style>

<script>
  // 全部展開／收合。錨點進站時自動展開對應題目，讓 #q7 這類連結可直接分享。
  const btn = document.querySelector<HTMLButtonElement>('[data-expand]');
  const items = Array.from(document.querySelectorAll<HTMLDetailsElement>('.q'));

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-pressed') === 'true';
    items.forEach((d) => { d.open = !open; });
    btn.setAttribute('aria-pressed', String(!open));
    btn.textContent = open ? '全部展開' : '全部收合';
  });

  function openFromHash() {
    const id = location.hash.slice(1);
    if (!id) return;
    const target = document.getElementById(id);
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView({ block: 'start' });
    }
  }

  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  /*
    六句疑慮與上方索引：明確處理點擊，不只靠 hashchange。
    若使用者已經在 #q1、捲回去再點同一句，hash 沒有改變就不會觸發 hashchange，
    畫面等於沒反應。這裡直接展開並捲動，並短暫標示落點。
  */
  document.querySelectorAll<HTMLAnchorElement>('.doubt a, .toc a').forEach((link) => {
    link.addEventListener('click', (e) => {
      const id = link.getAttribute('href')?.slice(1);
      if (!id) return;
      const target = document.getElementById(id);
      if (!(target instanceof HTMLDetailsElement)) return;

      e.preventDefault();
      target.open = true;
      target.scrollIntoView({
        block: 'start',
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
      target.classList.add('is-target');
      window.setTimeout(() => target.classList.remove('is-target'), 1600);
      history.replaceState(null, '', `#${id}`);
    });
  });
</script>
