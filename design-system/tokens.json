    "1": {
      "$value": "0.25rem",
      "$type": "dimension"
    },
    "2": {
      "$value": "0.5rem",
      "$type": "dimension"
    },
    "3": {
      "$value": "0.75rem",
      "$type": "dimension"
    },
    "4": {
      "$value": "1rem",
      "$type": "dimension"
