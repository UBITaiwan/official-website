      "$value": "1.5rem",
      "$type": "dimension"
    },
    "8": {
      "$value": "2rem",
      "$type": "dimension"
    },
    "12": {
      "$value": "3rem",
      "$type": "dimension"
    },
    "16": {
      "$value": "4rem",
